< envPaths
errlogInit(20000)
dbLoadDatabase("$(TOP)/dbd/simDetectorApp.dbd")
simDetectorApp_registerRecordDeviceDriver(pdbbase)
epicsEnvSet("PREFIX", "BEC:SIM:")
epicsEnvSet("EPICS_DB_INCLUDE_PATH", "$(ADCORE)/db")

simDetectorConfig("SIM1", 512, 512, 1, 0, 0)
dbLoadRecords("$(ADSIMDETECTOR)/db/simDetector.template", "P=$(PREFIX),R=cam1:,PORT=SIM1,ADDR=0,TIMEOUT=1")

NDTransformConfigure("TRANS1", 20, 0, "SIM1", 0, 0, 0, 0, 0, 2)
dbLoadRecords("NDTransform.template", "P=$(PREFIX),R=Trans1:,PORT=TRANS1,ADDR=0,TIMEOUT=1,NDARRAY_PORT=SIM1")

NDROIConfigure("ROI1", 20, 0, "TRANS1", 0, 0, 0, 0, 0, 2)
dbLoadRecords("NDROI.template", "P=$(PREFIX),R=ROI1:,PORT=ROI1,ADDR=0,TIMEOUT=1,NDARRAY_PORT=TRANS1")

NDStatsConfigure("STATS1", 20, 0, "ROI1", 0, 0, 0, 0, 0, 2)
dbLoadRecords("NDStats.template", "P=$(PREFIX),R=Stats1:,PORT=STATS1,ADDR=0,TIMEOUT=1,HIST_SIZE=256,XSIZE=512,YSIZE=512,NCHANS=2048,NDARRAY_PORT=ROI1")
NDTimeSeriesConfigure("STATS1_TS", 20, 0, "STATS1", 1, 23)
dbLoadRecords("NDTimeSeries.template", "P=$(PREFIX),R=Stats1:TS:,PORT=STATS1_TS,ADDR=0,TIMEOUT=1,NDARRAY_PORT=STATS1,NDARRAY_ADDR=1,NCHANS=2048,ENABLED=1")

NDROIConfigure("ROI2", 20, 0, "TRANS1", 0, 0, 0, 0, 0, 2)
dbLoadRecords("NDROI.template", "P=$(PREFIX),R=ROI2:,PORT=ROI2,ADDR=0,TIMEOUT=1,NDARRAY_PORT=TRANS1")

NDStatsConfigure("STATS2", 20, 0, "ROI2", 0, 0, 0, 0, 0, 2)
dbLoadRecords("NDStats.template", "P=$(PREFIX),R=Stats2:,PORT=STATS2,ADDR=0,TIMEOUT=1,HIST_SIZE=256,XSIZE=512,YSIZE=512,NCHANS=2048,NDARRAY_PORT=ROI2")
NDTimeSeriesConfigure("STATS2_TS", 20, 0, "STATS2", 1, 23)
dbLoadRecords("NDTimeSeries.template", "P=$(PREFIX),R=Stats2:TS:,PORT=STATS2_TS,ADDR=0,TIMEOUT=1,NDARRAY_PORT=STATS2,NDARRAY_ADDR=1,NCHANS=2048,ENABLED=1")

NDStdArraysConfigure("IMAGE1", 5, 0, "TRANS1", 0)
dbLoadRecords("NDStdArrays.template", "P=$(PREFIX),R=image1:,PORT=IMAGE1,ADDR=0,TIMEOUT=1,NDARRAY_PORT=TRANS1,TYPE=Int8,FTVL=UCHAR,NELEMENTS=262144")


# Save the same IOC-transformed full images to HDF5 on explicit capture.
NDFileHDF5Configure("HDF1", 20, 0, "TRANS1", 0)
dbLoadRecords("NDFileHDF5.template", "P=$(PREFIX),R=HDF1:,PORT=HDF1,ADDR=0,TIMEOUT=1,XMLSIZE=2048,NDARRAY_PORT=TRANS1")

# Publish IOC-transformed arrays directly over ZMQ.
NDZMQConfigure("ZMQ1", "tcp://*:5555", 5, 0, "TRANS1", 0, 0, 0, 0, 0)
dbLoadRecords("NDPluginBase.template", "P=$(PREFIX),R=ZMQ1:,PORT=ZMQ1,ADDR=0,TIMEOUT=1,NDARRAY_PORT=TRANS1,NDARRAY_ADDR=0")

