<mxfile><diagram id="priority-policy" name="Camera acquisition"><mxGraphModel background="#F8FAFC" adaptiveColors="auto" page="0" grid="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Camera acquisition" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=36;fontColor=#0F172A;align=left;fontStyle=1;strokeColor=none;fillColor=none;"><mxGeometry as="geometry" x="60" y="20" width="1550" height="55" /></mxCell><mxCell id="subtitle" value="Readout priority selects the lifecycle. Async acquisition selects source and length independently." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#0F172A;align=left;fontStyle=1;strokeColor=none;fillColor=none;"><mxGeometry as="geometry" x="60" y="85" width="1550" height="40" /></mxCell><mxCell id="section1" value="01   Resolve scan settings" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#0F172A;align=left;fontStyle=1;strokeColor=none;fillColor=none;"><mxGeometry as="geometry" x="60" y="280.0" width="1550" height="40" /></mxCell><mxCell id="participation" value="&lt;b&gt;SCAN PARTICIPATION&lt;/b&gt;&lt;br&gt;&lt;br&gt;Readout priority?" vertex="1" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;spacing=16;align=left;strokeWidth=1.2;fillColor=#FFFBEB;strokeColor=#FCD34D;fontColor=#78350F;"><mxGeometry as="geometry" x="60" y="355.0" width="320" height="110" /></mxCell><mxCell id="request" value="&lt;b&gt;ON REQUEST&lt;/b&gt;&lt;br&gt;&lt;br&gt;Keep live behavior.&lt;br&gt;No scan ROI or HDF5 capture." vertex="1" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;spacing=16;align=left;strokeWidth=1.2;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;"><mxGeometry as="geometry" x="60" y="545.0" width="320" height="130" /></mxCell><mxCell id="timing" value="&lt;b&gt;use_scan_timing&lt;/b&gt;&lt;br&gt;&lt;br&gt;Where do exposure, period and burst size come from?" vertex="1" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;spacing=16;align=left;strokeWidth=1.2;fillColor=#FFFBEB;strokeColor=#FCD34D;fontColor=#78350F;"><mxGeometry as="geometry" x="680" y="355.0" width="400" height="110" /></mxCell><mxCell id="scan" value="&lt;b&gt;SCAN SETTINGS&lt;/b&gt;&lt;br&gt;&lt;br&gt;period = info.exp_time&lt;br&gt;readout = max(scan readout, detector readout)&lt;br&gt;exposure = period − readout&lt;br&gt;burst = info.frames_per_trigger" vertex="1" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;spacing=16;align=left;strokeWidth=1.2;fillColor=#EFF6FF;strokeColor=#BFDBFE;fontColor=#1E3A8A;"><mxGeometry as="geometry" x="480" y="545.0" width="400" height="170" /></mxCell><mxCell id="manual" value="&lt;b&gt;CONTROLLER SETTINGS&lt;/b&gt;&lt;br&gt;&lt;br&gt;exposure = cam.acquire_time&lt;br&gt;period = cam.acquire_period&lt;br&gt;burst = cam.num_images" vertex="1" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;spacing=16;align=left;strokeWidth=1.2;fillColor=#EFF6FF;strokeColor=#BFDBFE;fontColor=#1E3A8A;"><mxGeometry as="geometry" x="1050" y="545.0" width="400" height="170" /></mxCell><mxCell id="apply" value="&lt;b&gt;APPLY TIMING AT STAGE&lt;/b&gt;&lt;br&gt;&lt;br&gt;AcquireTime ← exposure&lt;br&gt;AcquirePeriod ← period" vertex="1" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;spacing=16;align=left;strokeWidth=1.2;fillColor=#EFF6FF;strokeColor=#BFDBFE;fontColor=#1E3A8A;"><mxGeometry as="geometry" x="680" y="810.0" width="400" height="125" /></mxCell><mxCell id="section2" value="02   Select lifecycle from readout priority" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#0F172A;align=left;fontStyle=1;strokeColor=none;fillColor=none;"><mxGeometry as="geometry" x="60" y="985.0" width="1550" height="40" /></mxCell><mxCell id="priority" value="&lt;b&gt;READOUT PRIORITY&lt;/b&gt;&lt;br&gt;&lt;br&gt;baseline / monitored / async" vertex="1" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;spacing=16;align=left;strokeWidth=1.2;fillColor=#FFFBEB;strokeColor=#FCD34D;fontColor=#78350F;"><mxGeometry as="geometry" x="680" y="1055.0" width="400" height="110" /></mxCell><mxCell id="baseline" value="&lt;b&gt;BASELINE&lt;/b&gt;&lt;br&gt;&lt;br&gt;One finite burst in on_pre_scan.&lt;br&gt;softwareTrigger: false&lt;br&gt;acquisition_mode is ignored." vertex="1" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;spacing=16;align=left;strokeWidth=1.2;fillColor=#ECFDF5;strokeColor=#99F6E4;fontColor=#115E59;"><mxGeometry as="geometry" x="60" y="1265.0" width="380" height="145" /></mxCell><mxCell id="monitored" value="&lt;b&gt;MONITORED&lt;/b&gt;&lt;br&gt;&lt;br&gt;One finite burst per BEC trigger.&lt;br&gt;softwareTrigger: true&lt;br&gt;acquisition_mode is ignored." vertex="1" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;spacing=16;align=left;strokeWidth=1.2;fillColor=#ECFDF5;strokeColor=#99F6E4;fontColor=#115E59;"><mxGeometry as="geometry" x="570" y="1265.0" width="380" height="145" /></mxCell><mxCell id="async" value="&lt;b&gt;ASYNC SOURCE&lt;/b&gt;&lt;br&gt;&lt;br&gt;softwareTrigger: false&lt;br&gt;acquisition_source?" vertex="1" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;spacing=16;align=left;strokeWidth=1.2;fillColor=#FFFBEB;strokeColor=#FCD34D;fontColor=#78350F;"><mxGeometry as="geometry" x="1110" y="1265.0" width="440" height="145" /></mxCell><mxCell id="baselinepv" value="&lt;b&gt;BASELINE AD SETTINGS&lt;/b&gt;&lt;br&gt;&lt;br&gt;ImageMode = Multiple&lt;br&gt;NumImages = burst&lt;br&gt;TriggerMode = internal_trigger_mode.value" vertex="1" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;spacing=16;align=left;strokeWidth=1.2;fillColor=#EFF6FF;strokeColor=#BFDBFE;fontColor=#1E3A8A;"><mxGeometry as="geometry" x="60" y="1495.0" width="380" height="150" /></mxCell><mxCell id="monitoredpv" value="&lt;b&gt;MONITORED AD SETTINGS&lt;/b&gt;&lt;br&gt;&lt;br&gt;ImageMode = Multiple&lt;br&gt;NumImages = burst&lt;br&gt;TriggerMode = internal_trigger_mode.value" vertex="1" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;spacing=16;align=left;strokeWidth=1.2;fillColor=#EFF6FF;strokeColor=#BFDBFE;fontColor=#1E3A8A;"><mxGeometry as="geometry" x="570" y="1495.0" width="380" height="150" /></mxCell><mxCell id="internal" value="&lt;b&gt;INTERNAL CLOCK&lt;/b&gt;&lt;br&gt;&lt;br&gt;TriggerMode =&lt;br&gt;internal_trigger_mode.value" vertex="1" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;spacing=16;align=left;strokeWidth=1.2;fillColor=#EFF6FF;strokeColor=#BFDBFE;fontColor=#1E3A8A;"><mxGeometry as="geometry" x="1040" y="1495" width="300" height="130" /></mxCell><mxCell id="external" value="&lt;b&gt;EXTERNAL PULSES&lt;/b&gt;&lt;br&gt;&lt;br&gt;TriggerMode =&lt;br&gt;external_trigger_mode.value" vertex="1" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;spacing=16;align=left;strokeWidth=1.2;fillColor=#EFF6FF;strokeColor=#BFDBFE;fontColor=#1E3A8A;"><mxGeometry as="geometry" x="1400" y="1495" width="300" height="130" /></mxCell><mxCell id="section3" value="03   Acquire and publish" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#0F172A;align=left;fontStyle=1;strokeColor=none;fillColor=none;"><mxGeometry as="geometry" x="60" y="2225" width="1550" height="40" /></mxCell><mxCell id="bursts" value="&lt;b&gt;FINITE BURSTS&lt;/b&gt;&lt;br&gt;&lt;br&gt;Arm optional HDF5 at stage.&lt;br&gt;For each burst: arm ROI → acquire → drain → publish.&lt;br&gt;Baseline: one averaged value per ROI.&lt;br&gt;Monitored: ROI publication finishes before trigger status." vertex="1" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;spacing=16;align=left;strokeWidth=1.2;fillColor=#ECFDF5;strokeColor=#99F6E4;fontColor=#115E59;"><mxGeometry as="geometry" x="260" y="2315" width="650" height="190" /></mxCell><mxCell id="stream" value="&lt;b&gt;INDEPENDENT ACQUISITION&lt;/b&gt;&lt;br&gt;&lt;br&gt;Stage: arm ROI/HDF5 before starting input.&lt;br&gt;Internal: starts camera input. External: arms for pulses.&lt;br&gt;Stream ROI statistics through async dynamic signals.&lt;br&gt;Fixed ROI buffers: samples per scan must fit capacity.&lt;br&gt;BEC trigger calls do not reacquire." vertex="1" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;spacing=16;align=left;strokeWidth=1.2;fillColor=#ECFDF5;strokeColor=#99F6E4;fontColor=#115E59;"><mxGeometry as="geometry" x="1110" y="2315" width="590" height="190" /></mxCell><mxCell id="section4" value="04   Complete and return to live" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#0F172A;align=left;fontStyle=1;strokeColor=none;fillColor=none;"><mxGeometry as="geometry" x="60" y="2585" width="1550" height="40" /></mxCell><mxCell id="complete" value="&lt;b&gt;ON COMPLETE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Baseline / monitored: finish pending bursts.&lt;br&gt;Async fixed: wait for camera idle and validate total frames.&lt;br&gt;Async continuous: stop input; no exact HDF5 count required.&lt;br&gt;&lt;br&gt;Drain ROIs. Fixed acquisition waits for all HDF5 frames.&lt;br&gt;Close the file, check writer errors and publish its final event." vertex="1" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;spacing=16;align=left;strokeWidth=1.2;fillColor=#F5F3FF;strokeColor=#DDD6FE;fontColor=#5B21B6;"><mxGeometry as="geometry" x="680" y="2675" width="500" height="235" /></mxCell><mxCell id="enabled" value="&lt;b&gt;SUCCESSFUL UNSTAGE&lt;/b&gt;&lt;br&gt;&lt;br&gt;live_enabled?" vertex="1" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;spacing=16;align=left;strokeWidth=1.2;fillColor=#FFFBEB;strokeColor=#FCD34D;fontColor=#78350F;"><mxGeometry as="geometry" x="760" y="2990" width="340" height="105" /></mxCell><mxCell id="idle" value="&lt;b&gt;LIVE DISABLED&lt;/b&gt;&lt;br&gt;&lt;br&gt;Remain stopped." vertex="1" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;spacing=16;align=left;strokeWidth=1.2;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;"><mxGeometry as="geometry" x="200" y="3180" width="360" height="115" /></mxCell><mxCell id="live" value="&lt;b&gt;RESUME LIVE&lt;/b&gt;&lt;br&gt;&lt;br&gt;live_follows_scan_timing true → use latest resolved timing.&lt;br&gt;false → restore pre-scan exposure / period.&lt;br&gt;Continuous image mode + internal trigger.&lt;br&gt;Enable image preview and start Acquire." vertex="1" parent="1" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;spacing=16;align=left;strokeWidth=1.2;fillColor=#ECFDF5;strokeColor=#99F6E4;fontColor=#115E59;"><mxGeometry as="geometry" x="1070" y="3180" width="630" height="180" /></mxCell><mxCell id="foot" value="Source and length apply only to async. Baseline / monitored always use fixed internal bursts. BEC softwareTrigger is validated against priority." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#0F172A;align=left;fontStyle=1;strokeColor=none;fillColor=none;"><mxGeometry as="geometry" x="60" y="3450" width="1550" height="40" /></mxCell><mxCell id="e1" source="participation" target="request" value="on_request" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#64748B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=13;fontColor=#475569;labelBackgroundColor=#F8FAFC;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" source="timing" target="scan" value="true" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#64748B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=13;fontColor=#475569;labelBackgroundColor=#F8FAFC;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" source="timing" target="manual" value="false" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#64748B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=13;fontColor=#475569;labelBackgroundColor=#F8FAFC;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e5" source="scan" target="apply" value="" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#64748B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=13;fontColor=#475569;labelBackgroundColor=#F8FAFC;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e6" source="manual" target="apply" value="" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#64748B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=13;fontColor=#475569;labelBackgroundColor=#F8FAFC;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e7" source="apply" target="priority" value="" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#64748B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=13;fontColor=#475569;labelBackgroundColor=#F8FAFC;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e8" source="priority" target="baseline" value="baseline" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#64748B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=13;fontColor=#475569;labelBackgroundColor=#F8FAFC;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e9" source="priority" target="monitored" value="monitored" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#64748B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=13;fontColor=#475569;labelBackgroundColor=#F8FAFC;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e10" source="priority" target="async" value="async" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#64748B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=13;fontColor=#475569;labelBackgroundColor=#F8FAFC;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e11" source="baseline" target="baselinepv" value="" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#64748B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=13;fontColor=#475569;labelBackgroundColor=#F8FAFC;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e12" source="monitored" target="monitoredpv" value="" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#64748B;strokeWidth=1.6;fontFamily=Helvetica;fontSize=13;fontColor=#475569;labelBackgroundColor=#F8FAFC;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e13" source="async" target="internal" value="internal" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#64748B;strokeWi